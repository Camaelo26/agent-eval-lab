# Golden dataset for the support agent suite.
# Each line is one labelled case. Comments and blank lines are ignored by the loader.
# `expected` is a condensed reference answer, not a copy of the context chunk, so a
# copy-paste agent scores well but not perfectly. `unanswerable` cases expect a refusal.
{"id": "billing-001", "question": "How do I download a past invoice?", "context": ["Past invoices are available under Settings then Billing then Invoice History. Select any invoice and choose Download PDF. Invoices remain available for 24 months after issue.", "Usage dashboards refresh every six hours and show consumption per workspace seat.", "Support hours are Monday to Friday, 8am to 6pm Central Time."], "expected": "Go to Settings, Billing, Invoice History and choose Download PDF. Invoices stay available for 24 months.", "expected_tools": ["search_docs", "billing_api"], "tags": ["billing", "retrieval"]}
{"id": "billing-002", "question": "What is the refund window for an annual plan?", "context": ["Annual plans can be refunded in full within 30 days of the charge date. After 30 days the plan converts to a pro-rated credit that applies to the next renewal.", "Monthly plans renew automatically on the same calendar day each month.", "Enterprise contracts are negotiated separately and are governed by the signed order form."], "expected": "Annual plans are fully refundable within 30 days of the charge; after that you get a pro-rated credit toward renewal.", "expected_tools": ["search_docs", "lookup_order", "billing_api"], "tags": ["billing", "refunds"]}
{"id": "billing-003", "question": "My card was declined, what happens to my account?", "context": ["When a card is declined we retry the charge on day 1, day 3 and day 7. The workspace stays active during the retry period and moves to read-only if all three attempts fail.", "Adding a backup payment method is available on the Billing page for all paid tiers.", "Invoices are issued in USD unless a different currency was set at signup."], "expected": "We retry the charge on days 1, 3 and 7. The workspace stays active during retries and becomes read-only if all three fail.", "expected_tools": ["search_docs", "billing_api"], "tags": ["billing", "retrieval"]}
{"id": "auth-001", "question": "How do I reset my password?", "context": ["To reset a password, choose Forgot Password on the sign-in screen and enter your work email. The reset link is valid for 60 minutes and can only be used once.", "Single sign-on customers manage credentials in their own identity provider.", "Session cookies expire after 14 days of inactivity."], "expected": "Use Forgot Password on the sign-in screen and enter your work email. The reset link is single-use and expires in 60 minutes.", "expected_tools": ["search_docs", "auth_service"], "tags": ["auth", "retrieval"]}
{"id": "auth-002", "question": "Can I turn off 2fa for my whole team?", "context": ["Two-factor authentication is enforced at the workspace level by an owner. Once enforcement is enabled it cannot be disabled by individual members, only by an owner in Security Settings.", "Personal access tokens are scoped per user and expire after 90 days.", "Audit logs retain sign-in events for 12 months."], "expected": "Only a workspace owner can disable 2fa enforcement, from Security Settings. Individual members cannot turn it off.", "expected_tools": ["search_docs", "auth_service"], "tags": ["auth", "permissions"]}
{"id": "auth-003", "question": "My account is locked after too many login attempts", "context": ["An account locks for 15 minutes after five consecutive failed sign-in attempts. The lock clears automatically, and a workspace owner can clear it early from the Members page.", "Email change requests require confirmation from both the old and the new address.", "We support Google, Microsoft and Okta as identity providers."], "expected": "Five failed sign-in attempts lock the account for 15 minutes. It clears on its own, or an owner can clear it from the Members page.", "expected_tools": ["search_docs", "auth_service"], "tags": ["auth", "retrieval"]}
{"id": "ship-001", "question": "How long does standard delivery take?", "context": ["Standard delivery arrives in three to five business days after the order ships. Orders placed after 2pm Central ship the following business day.", "Gift wrapping adds one business day to fulfilment.", "Tracking numbers are emailed as soon as the carrier scans the parcel."], "expected": "Three to five business days after shipping. Orders placed after 2pm Central ship the next business day.", "expected_tools": ["search_docs", "lookup_order"], "tags": ["shipping", "retrieval"]}
{"id": "ship-002", "question": "Do you ship internationally and who pays customs?", "context": ["We ship to 32 countries. International orders are sent delivery duties unpaid, which means the recipient is responsible for customs duties and import taxes on arrival.", "Domestic orders over 75 dollars ship free.", "Warehouse processing takes one business day for in-stock items."], "expected": "Yes, to 32 countries. Orders ship duties unpaid, so the recipient pays customs duties and import taxes.", "expected_tools": ["search_docs", "lookup_order"], "tags": ["shipping", "policy"]}
{"id": "policy-001", "question": "How long do you keep my data after I delete my account?", "context": ["After account deletion, workspace data is soft deleted for 30 days so it can be restored on request. After 30 days it is purged from primary storage, and encrypted backups roll off within a further 60 days.", "Data is stored in the us-east region unless a different region was chosen at signup.", "We publish a subprocessor list and update it 30 days before any change."], "expected": "Data is soft deleted for 30 days and restorable, then purged from primary storage. Encrypted backups roll off within another 60 days.", "expected_tools": ["search_docs"], "tags": ["policy", "retrieval"]}
{"id": "policy-002", "question": "How do I cancel my subscription?", "context": ["Cancel from Settings then Billing then Cancel Plan. Cancellation takes effect at the end of the current billing period and the workspace stays fully usable until then.", "Seats can be added at any time and are billed pro rata.", "Downgrades between paid tiers apply immediately."], "expected": "Cancel under Settings, Billing, Cancel Plan. It takes effect at the end of the current billing period and the workspace works until then.", "expected_tools": ["search_docs", "billing_api"], "tags": ["policy", "billing"]}
{"id": "multi-001", "question": "What is the refund window and does cancelling end my access immediately?", "context": ["Annual plans can be refunded in full within 30 days of the charge date.", "Cancellation takes effect at the end of the current billing period and the workspace stays fully usable until then.", "Enterprise contracts are governed by the signed order form."], "expected": "Annual plans are refundable within 30 days of the charge, and cancelling keeps access until the end of the current billing period.", "expected_tools": ["search_docs", "lookup_order", "billing_api"], "tags": ["multi-hop", "billing"]}
